# Copy this file to .env and fill in real values
# NEVER commit the real .env file to GitHub

# --- Database (Postgres) ---
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_HOST:PORT/defaultdb?sslmode=require

PGHOST=your-aiven-host.aivencloud.com
PGPORT=24979
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=YOUR_PASSWORD_HERE
PGSSLMODE=require

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string

# Owner email becomes admin role on self-registration (optional)
OWNER_EMAIL=your-email@example.com

# Env-based admin login (separate from customer accounts)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=YourSecureAdminPassword

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Rubicon Capital <noreply@rubiconcapital.org>
SUPPORT_EMAIL=rubiconcapital@rubiconcapital.org
SUPPORT_PHONE=+12136061732
APP_URL=https://www.rubiconcapital.org

# --- External cron (cron-job.org) ---
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

PORT=4000
