# Copy this file to .env and fill in real values
# NEVER commit the real .env file to GitHub

# --- Database (Postgres / Neon) ---
# Prefer a single DATABASE_URL (recommended)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional fallback individual vars (only used if DATABASE_URL is not set)
# PGHOST=
# PGPORT=5432
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=
# PGSSLMODE=require

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string

# Owner email becomes admin role on self-registration (optional)
OWNER_EMAIL=your-email@example.com

# Env-based admin login (separate from customer accounts)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=YourSecureAdminPassword

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Rubicon Capital <noreply@rubiconcapital.org>
SUPPORT_EMAIL=rubiconcapital@rubiconcapital.org
SUPPORT_PHONE=+12136061732
APP_URL=https://www.rubiconcapital.org

# --- External cron (cron-job.org) ---
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

PORT=4000

# --- Cloudinary (profile photos) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Transfers ---
# false/omitted = all transfers pending until admin Release or Block
# true = internal (on-platform) transfers complete instantly
TRANSFER_AUTO_COMPLETE=false
